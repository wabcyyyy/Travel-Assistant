# Sinan 生产边缘：自动 HTTPS + 静态托管 + /api 反代，单文件即全部路由。
# 路由语义与 travel-frontend-vue/nginx.conf（本地容器演示链路）对齐，两处改动必须同步：
#   1. agent 直调面（/api/agent/**）与 /mcp 绝不经边缘可达（R1-8）
#   2. /api 反代必须【替换】XFF（后端 app/common/client_ip.py 按可信网段从右往左取跳）
# 域名单一来源：compose 注入的 DOMAIN（根 .env）。Caddy 据此自动签发/续期证书并做
# 80→443 跳转；暂无域名时把 DOMAIN 设为 localhost 可在本机预演（附录见 deploy/README.md）。

{$DOMAIN} {
	# 静态资源：前端构建产物（前端 Dockerfile 的 caddy target 已 COPY 到 /srv）
	encode zstd gzip
	root * /srv

	# route 块 = 显式保序（Caddy 规范序里 try_files 先于 respond/reverse_proxy，会把
	# /api/** 先改写成 /index.html——预演实证；等价于 nginx 的 location 优先级语义）。
	# 顺序即语义：先 deny（R1-8），再业务反代，最后 SPA fallback。
	route {
		# R1-8：agent 面（自带 X-Agent-Token 鉴权、接受调用方自备 user_id）与 MCP 出口
		# 只允许内网直连，绝不对公网开放——与 nginx.conf 的 deny all 同义。
		respond /api/agent/* 403
		respond /mcp* 403

		# 业务面反代（SSE 长推与 300s 生成 deadline 都在此链路上：flush 立即、不设读超时）。
		# header_up 显式替换 XFF：Caddy 默认就不信任来路 XFF，这里写明以防版本语义变化，
		# 与 nginx.conf 的 `proxy_set_header X-Forwarded-For $remote_addr` 同一安全姿态。
		reverse_proxy /api/* agent-python:8000 {
			header_up X-Forwarded-For {http.request.remote.host}
			flush_interval -1
		}

		try_files {path} /index.html
		file_server
	}
}
