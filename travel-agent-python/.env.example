LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen-plus
# 对话修改使用的低延迟模型；留空则复用 LLM_MODEL
LLM_FAST_MODEL=qwen-turbo
LLM_TIMEOUT=60
AGENT_HOST=127.0.0.1
AGENT_RELOAD=false
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token
# 高德官方 MCP（Agent 侧推荐）
AMAP_MCP_ENABLED=false
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_KEY=your-amap-key
AMAP_MCP_TIMEOUT=15
# MCP 未启用或失败时的旧 Web API 降级 key
AMAP_WEB_KEY=your-amap-web-key
# Unsplash 图片检索（用于 POI 实景图，替代高德地图位置图）；留空则跳过
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
LIVE_PRICE_SEARCH=true
MAX_LIVE_QUERIES=3
DEFAULT_BUDGET=1000
# RAG：hashed 为无外部模型依赖的离线默认值；semantic 需安装 sentence-transformers
RAG_EMBEDDING_PROVIDER=hashed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=20
RAG_RRF_K=60
RAG_DOCUMENT_VERSION=poi-fields-v2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=travel_assistant
