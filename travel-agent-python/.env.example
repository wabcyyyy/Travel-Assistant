LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen-plus
# 对话修改使用的低延迟模型；留空则复用 LLM_MODEL
LLM_FAST_MODEL=qwen-turbo
# 行程 JSON 生成模型；留空默认使用 LLM_FAST_MODEL 以降低等待
LLM_GENERATION_MODEL=
LLM_TIMEOUT=60
# LLM 连接池
LLM_POOL_MAX_CONNECTIONS=20
LLM_POOL_MAX_KEEPALIVE=10
LLM_CONNECT_TIMEOUT=5
AGENT_HOST=127.0.0.1
AGENT_RELOAD=false
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 必填（非回环绑定时启动强制）：与 Java AGENT_INTERNAL_TOKEN 一致
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token
# 高德官方 MCP（Agent 侧推荐）
AMAP_MCP_ENABLED=false
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_KEY=your-amap-key
AMAP_MCP_TIMEOUT=15
# MCP 未启用或失败时的旧 Web API 降级 key
AMAP_WEB_KEY=your-amap-web-key
# 国外目的地兜底提供商（provider chain: 高德 → Google）。配置后高德无结果的
# POI 检索/路线自动切 Google Places/Routes（国外落坐标、路线）；未配置保持现状。
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT=10
# OSM Nominatim 免 key 兜底（默认关闭：国内网络常超时，会拖垮 Agent Deadline）
NOMINATIM_ENABLED=false
# 真实路线服务：开启后优先调用高德步行/驾车路线，异常自动坐标估算降级
ROUTE_SERVICE_ENABLED=false
ROUTE_MODE=walking
ROUTE_TIMEOUT=8
ROUTE_CACHE_TTL=900
ROUTE_PEAK_FACTOR=1.25
ROUTE_MAX_CALLS=64
# 每次 Agent 请求的工具调用总预算（单工具上限由 Registry 定义）
TOOL_MAX_CALLS=32
AGENT_DEADLINE_SECONDS=90
MAX_LLM_CALLS=8
MAX_TOKEN_BUDGET=12000
MAX_REPLANS=3
NO_PROGRESS_LIMIT=2
TRACE_STORAGE_ENABLED=true
# TRACE_STORAGE_PATH=data/agent_traces.jsonl
SCHEDULE_OPTIMIZER_ENABLED=true
# Unsplash 图片检索（用于 POI 实景图，替代高德地图位置图）；留空则跳过
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# 实时酒店价格会增加联网/模型等待；默认关闭，需核价时再开启
LIVE_PRICE_SEARCH=false
MAX_LIVE_QUERIES=1
DEFAULT_BUDGET=1000
# RAG：hashed 为无外部模型依赖的离线默认值；semantic 需安装 sentence-transformers
RAG_EMBEDDING_PROVIDER=hashed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=20
RAG_RRF_K=60
RAG_DOCUMENT_VERSION=poi-fields-v2
# P2：查询路由（无意图查询走评分枚举、精确名走词法直查）
RAG_ROUTER_ENABLED=true
# P2：检索结果语义缓存（精确键+近似键；降级与空结果不缓存）
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=512
RAG_CACHE_SIMILARITY=0.95
# P2：轻量 GraphRAG（同城坐标网格近邻 + 标签相邻）
RAG_GRAPH_RADIUS_M=2000
RAG_GRAPH_NEARBY_LIMIT=5
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=travel_assistant
# MySQL 连接池上限（Agent 只读 + 管线写库共用）
DB_POOL_MAX=10
